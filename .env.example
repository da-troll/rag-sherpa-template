# Pinecone
PINECONE_API_KEY=op://<YOUR_VAULT>/Pinecone API Key/credential
PINECONE_INDEX=n8n-your-namespace-bot-1536
PINECONE_NAMESPACE=your-namespace

# OpenAI
OPENAI_API_KEY=op://<YOUR_VAULT>/OpenAI API Key/api key

# LlamaCloud
LLAMA_CLOUD_API_KEY=op://<YOUR_VAULT>/LlamaCloud API Key/credential

# Miscellaneous
SLACK_JSON_PATH=data/slack/slack_C0000000000.json
TRUSTED_USERS={U0000000001,U0000000002,U0000000003,U0000000004,U0000000005}

# Slack
SLACK_TOKEN=op://<YOUR_VAULT>/Slack Bot Token/credential
SLACK_CHANNEL_ID=C0000000000
SLACK_WORKSPACE_HOST=https://your-workspace.slack.com

# Embedding & Chunking
EMBED_MODEL=text-embedding-3-small
BATCH_SIZE=64
SLACK_CHUNK_CHARS=1500
ARTICLE_CHUNK_CHARS=1000
SLACK_CHUNK_OVERLAP=300
ARTICLE_CHUNK_OVERLAP=300

# Anthropic-style contextual retrieval (Tier 1 of RAG_IMPROVEMENTS_PLAN.md).
# Set to 0 to disable; cheap LLM call per chunk during ingestion.
CONTEXTUAL_RETRIEVAL=1
CONTEXTUAL_MODEL=gpt-4o-mini

# Scraper (scrape-articles.py — Step 0 of the help-center pipeline).
# Comma-separated listing-page URLs. Articles linked from these pages get fetched.
HELP_CENTER_LISTING_URLS=https://your-helpcenter.example.com/en/support/solutions/folders/201000266899/page/1?url_locale=en,https://your-helpcenter.example.com/en/support/solutions/folders/201000266899/page/2?url_locale=en
SCRAPE_DELAY_SECONDS=1.5


# Experimental: set to 1 to DISABLE the Slack bot-message filter at ingest time.
# Used only for the self-ingestion drift A/B experiment in experiments/.
# Default 0 keeps RAG Bot's own replies out of the index.
SLACK_INCLUDE_BOTS=0

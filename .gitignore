# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# Local env file. Always ignored — even though the canonical version holds
# op:// references (not real secrets), users may paste plaintext into it as
# the documented escape hatch, and that should never reach git.
# A committed .env.example seeds new clones via `cp .env.example .env`.
.env
.env.local
.env.*.local
.env.backup*
.env.bak

# Past-iteration files (kept locally for reference, not for git history)
archive/

# Slack exports — contain real user IDs and message content, large, regenerable
# via ingest/fetch-all-messages.py. Pattern matches both old (repo-root) and
# new (data/slack/) locations. We ignore CONTENTS (not the dir itself) so the
# .gitkeep exception below keeps the dir alive in version control.
slack_*.json
slack_*.csv
data/slack/*
!data/slack/.gitkeep
message-fetches/

# Throwaway smoke tests / one-shot scripts (e.g. _genericize.py, _wipe_namespace.py)
_*.py
_*.txt

# Internal working docs (planning notes, scratchpads, audit + roadmap).
# These describe how we got here / where we're going — not part of the live
# pipeline spec. Live spec lives in README.md, CLAUDE.md, and code.
RAG_IMPROVEMENTS_PLAN.md
GENERICIZATION_PLAN.md

# Eval results (regenerable; per-run retrieval scores aren't useful in git history).
# Ignore CONTENTS (not the dir itself) so sample.json can be re-included.
eval/results/*
!eval/results/sample.json

# Scraper per-URL HTML cache (regenerable; large)
data/articles/.cache/

# LlamaParse test-run output (regenerable, throwaway)
data/articles/markdown_help_articles.test.json
